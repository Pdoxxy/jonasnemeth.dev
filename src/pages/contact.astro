---
import Layout from '../layouts/Layout.astro';
import '../styles/contact.css';
---

<Layout>
  <main class="contact-page">

    <section class="contact-hero">
      <div>
        <p class="contact-label">Contact</p>

        <h1>
          Get in
          <span>touch.</span>
        </h1>
      </div>

      <p class="contact-intro">
        If you'd like to get in touch about work, projects or something
        I've built, email is the easiest way to reach me.
      </p>
    </section>


    <section class="contact-details">
      <div class="contact-heading">
        <span>Contact details</span>

        <h2>
          Email, LinkedIn
          and GitHub.
        </h2>
      </div>

      <div class="contact-links">
        <a href="mailto:contact@jonasnemeth.dev">
          <span>Email</span>
          <strong>contact@jonasnemeth.dev</strong>
          <b aria-hidden="true">→</b>
        </a>

        <a
          href="https://www.linkedin.com/in/jonas-nemeth-546b43b9"
          target="_blank"
          rel="noreferrer"
        >
          <span>LinkedIn</span>
          <strong>Jonas Németh</strong>
          <b aria-hidden="true">↗</b>
        </a>

        <a
          href="https://github.com/Pdoxxy"
          target="_blank"
          rel="noreferrer"
        >
          <span>GitHub</span>
          <strong>Pdoxxy</strong>
          <b aria-hidden="true">↗</b>
        </a>
      </div>
    </section>

  </main>
</Layout>
